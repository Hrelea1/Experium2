# Experium Backend — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Option 1: Full connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/experium

# Option 2: Individual parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=experium
DB_USER=postgres
DB_PASSWORD=password

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_here_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Use Gmail, Resend, Mailgun, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@experium.ro

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Maps ─────────────────────────────────────────────────────────────────────
MAPBOX_TOKEN=your_mapbox_public_token

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://experium.ro
OTP_EXPIRY_MINUTES=10
